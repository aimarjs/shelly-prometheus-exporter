            "tags": [
              "tariff"
            ]
          }
        ]
      },
      "id": null,
      "panels": [
        {
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 3000
                  },
                  {
                    "color": "red",
                    "value": 5000
                  }
                ]
              },
              "unit": "watt"
            }
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 0
          },
          "id": 1,
          "targets": [
            {
              "expr": "sum(shelly_power_watts)",
              "legendFormat": "Total House Consumption",
              "refId": "A"
            }
          ],
          "title": "House Overview - Current Consumption",
          "type": "stat"
        },
        {
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 100
                  },
                  {
                    "color": "red",
                    "value": 200
                  }
                ]
              },
              "unit": "currencyEUR"
            }
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 0
          },
          "id": 2,
          "targets": [
            {
              "expr": "shelly_cost_trend_30d_eur",
              "legendFormat": "Monthly Cost",
              "refId": "A"
            }
          ],
          "title": "Cost So Far This Month",
          "type": "stat"
        },
        {
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
              },
              "unit": "kwh"
            }
          },
          "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 8
          },
          "id": 3,
          "targets": [
            {
              "expr": "shelly_energy_consumption_rate_kwh_per_hour",
              "legendFormat": "{{device}} - Consumption Rate",
              "refId": "A"
            }
          ],
          "title": "24h Usage Trends",
          "type": "timeseries"
        },
        {
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
              },
              "unit": "watt"
            }
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 16
          },
          "id": 4,
          "targets": [
            {
              "expr": "sum(shelly_power_watts{category=\"heating\"})",
              "legendFormat": "Heating",
              "refId": "A"
            },
            {
              "expr": "sum(shelly_power_watts{category=\"general\"})",
              "legendFormat": "General",
              "refId": "B"
            },
            {
              "expr": "sum(shelly_power_watts)",
              "legendFormat": "Total",
              "refId": "C"
            }
          ],
          "title": "Heating vs General Consumption",
          "type": "timeseries"
        },
        {
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "max": 100,
              "min": 0,
              "thresholds": {
                "steps": [
                  {
                    "color": "blue",
                    "value": null
                  },
                  {
                    "color": "green",
                    "value": 30
                  },
                  {
                    "color": "yellow",
                    "value": 60
                  },
                  {
                    "color": "red",
                    "value": 80
                  }
                ]
              },
              "unit": "percent"
            }
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 16
          },
          "id": 5,
          "targets": [
            {
              "expr": "shelly_heating_percentage_total",
              "legendFormat": "Heating % of Total",
              "refId": "A"
            }
          ],
          "title": "Heating Percentage",
          "type": "gauge"
        },
        {
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
              },
              "unit": "currencyEUR"
            }
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 24
          },
          "id": 6,
          "targets": [
            {
              "expr": "shelly_heating_cost_daily_eur",
              "legendFormat": "Heating",
              "refId": "A"
            },
            {
              "expr": "shelly_general_cost_daily_eur",
              "legendFormat": "General",
              "refId": "B"
            }
          ],
          "title": "Daily Cost Breakdown",
          "type": "piechart"
        },
        {
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
              },
              "unit": "currencyEUR"
            }
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 24
          },
          "id": 7,
          "targets": [
            {
              "expr": "shelly_heating_cost_daily_eur",
              "legendFormat": "Heating Cost",
              "refId": "A"
            },
            {
              "expr": "shelly_general_cost_daily_eur",
              "legendFormat": "General Cost",
              "refId": "B"
            },
            {
              "expr": "shelly_total_cost_daily_eur",
              "legendFormat": "Total Cost",
              "refId": "C"
            }
          ],
          "title": "Cost Trends (7 Days)",
          "type": "timeseries"
        },
        {
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
              },
              "unit": "watt"
            }
          },
          "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 32
          },
          "id": 8,
          "targets": [
            {
              "expr": "shelly_power_watts{category=\"heating\"}",
              "legendFormat": "{{device}} ({{name}}) - Heating",
              "refId": "A"
            },
            {
              "expr": "shelly_power_watts{category=\"general\"}",
              "legendFormat": "{{device}} ({{name}}) - General",
              "refId": "B"
            }
          ],
          "title": "Individual Device Power",
          "type": "timeseries"
        },
        {
          "fieldConfig": {
            "defaults": {
              "custom": {
                "displayMode": "table"
              }
            }
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 40
          },
          "id": 9,
          "targets": [
            {
              "expr": "shelly_device_category",
              "format": "table",
              "instant": true,
              "legendFormat": "Device Info",
              "refId": "A"
            }
          ],
          "title": "Device Categories",
          "type": "table"
        },
        {
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
              },
              "unit": "percent"
            }
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 40
          },
          "id": 10,
          "targets": [
            {
              "expr": "shelly_heating_efficiency_ratio",
              "legendFormat": "Heating Efficiency %",
              "refId": "A"
            }
          ],
          "title": "Heating Efficiency Trends",
          "type": "timeseries"
        }
      ],
      "refresh": "30s",
      "style": "dark",
      "tags": [
        "shelly",
        "heating",
        "cost",
        "energy"
      ],
      "templating": {
        "list": [
          {
            "includeAll": true,
            "multi": true,
            "name": "device",
            "query": "label_values(shelly_device_up, device)",
            "refresh": 1,
            "type": "query"
          },
          {
            "includeAll": true,
            "multi": true,
            "name": "category",
            "query": "label_values(shelly_device_category, category)",
            "refresh": 1,
            "type": "query"
          }
        ]
      },
      "time": {
        "from": "now-24h",
        "to": "now"
      },
